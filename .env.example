# Copy this file to .env and fill in your values. .env is ignored by git.

# Network the ESP32 creates when it runs as an access point (password: 8+ characters)
WIFI_AP_SSID="your-access-point-name"
WIFI_AP_PASSWORD="your-access-point-password"

# Existing network the ESP32 joins when USE_STATION_MODE is true
WIFI_STA_SSID="your-wifi-name"
WIFI_STA_PASSWORD="your-wifi-password"
